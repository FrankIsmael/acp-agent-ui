# ── Required ─────────────────────────────────────────────────────────────────
# The agent's ACP URL. Use its `agentUrl` field as-is (wss://…/acp). Without this the app
# does not try to connect: it tells you on screen instead of leaving you staring at a spinner.
ACP_WS_URL=wss://acp-<agentId>.sandboxes.easybits.cloud/acp

# The agent's token. Comes from creating the agent: it is its `embedToken`, unless you set
# your own `ACP_AGENT_TOKEN` in the `env`, in which case it is that one.
#
# ⚠️ It is NOT the box's GOOSE_SERVER__SECRET_KEY, as this file used to say: that is an
# internal secret that regenerates on every boot and never leaves the microVM.
# Sent as `?token=` in the URL and as `Authorization: Bearer`. Leave empty if your ACP
# agent does not require a credential.
ACP_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# Where the agent opens its sessions. In a ghosty-lite box, /data/work is what exists and the
# only path that survives sleep; if you set a path that does not exist inside, the agent
# falls back to /data/work without warning.
ACP_CWD=/data/work

# How long to wait (ms) for the agent to open or reopen a session. Includes starting the
# active MCP extensions: one that does not respond no longer leaves the conversation hanging.
ACP_SESSION_TIMEOUT_MS=60000

# Conversations open at once in the box (one per person talking). Same as the box relay's
# ACP_MAX_SESSIONS (ghosty-lite: 4 by default); when the pool is full the idle thread used
# longest ago is closed, never one that is currently responding.
ACP_MAX_SESSIONS=4

# Several boxes with the same agent (same prompt, skills, and model). With ACP_BOXES, these
# are ignored: ACP_WS_URL, ACP_TOKEN, AGENT_BOX_ID, AGENT_SNAPSHOT_ID, and ACP_MAX_SESSIONS.
# Each box reads its own values using its name in uppercase (letters and digits). The
# provider comes from the id: `m_…` is instabox (needs INSTABOX_API_KEY), anything else is
# EasyBits. New conversations go to the box with the most free slots; a conversation always
# reopens on its own box. Boxes number sessions alike (`20261028_1` on both), so the app gives
# each conversation its own id (`/c/k7f3q9`) and remembers its box in ACP_CONVERSATIONS_DB
# (default .data/conversations.db; persist and back it up with the rest of .data). Older links
# with an agent id open on the first box, so keep the box that holds them first, and don't
# rename boxes that already hold conversations.
# ACP_BOXES=chat,easy
# ACP_CHAT_WS_URL=wss://3100-<id>.instabox.tech/acp
# ACP_CHAT_TOKEN=
# ACP_CHAT_BOX_ID=m_…
# ACP_CHAT_MAX_SESSIONS=4
# ACP_EASY_WS_URL=wss://acp-<agentId>.sandboxes.easybits.cloud/acp
# ACP_EASY_TOKEN=
# ACP_EASY_BOX_ID=sb_…
# ACP_EASY_SNAPSHOT_ID=

# Box lifecycle (EasyBits ONLY): wake it when spoken to and suspend it when idle.
# Without these two, this is a normal ACP client against any provider: it connects, but
# does not wake anything — the agent must already be up.
AGENT_BOX_ID=
EASYBITS_API_KEY=

# Same for an instabox box (AGENT_BOX_ID=m_…): with this key, instabox is used instead of
# EasyBits. Create it with `instabox keys create --name acp-agent-ui --scope machines:read --scope machines:write`.
INSTABOX_API_KEY=
# INSTABOX_API_URL=https://api.instabox.sh

# Used to recreate the box if the host lost it. Note: the new box has a DIFFERENT URL, so
# ACP_WS_URL must be updated by hand.
AGENT_SNAPSHOT_ID=

# Models the gateway serves but the agent does not list in its selector.
# goose builds the select from the models it knows from its provider and that list falls
# short: the EasyBits gateway serves `deepseek-v4-flash-vision-exp` (the only one that sees
# images) and goose only offers flash and pro. Measured: `session/set_config_option` with an
# id outside its list IS accepted, so they are injected from here. Format: `id|Visible name`,
# comma-separated.
ACP_EXTRA_MODELS=deepseek-v4-flash-vision-exp|DeepSeek V4 Flash · visión

# Which of those models see images. ACP does not say: `promptCapabilities.image` is the
# AGENT's and goose always advertises it as true; if the chosen model cannot see, goose
# replaces the image with `[image omitted: model does not support vision]` without telling
# anyone. Empty = guessed from the name (`…-vision-…`, `…-vl-…`).
ACP_VISION_MODELS=deepseek-v4-flash-vision-exp

# Episodic memory: used by the backup/restore scripts (not by the UI).
# Backup finds it on its own if there is a single database in the box; set the path only
# if there are two, or to restore. Ghosty Lite:
SESSION_DB_PATH=/data/ghosty/data/sessions/sessions.db
AGENT_SERVICE=ghosty-lite-runtime.service
# Goose manual: SESSION_DB_PATH=/data/state/goose/sessions/sessions.db
# and the real systemd service, e.g. AGENT_SERVICE=goose-acp.service.

# Procedural memory: public repo, no embedded credentials.
SKILLS_REPO_URL=https://github.com/FrankIsmael/acp-agent-ui.git
SKILLS_REPO_BRANCH=main

ACP_EXTENSIONS_DB=.data/extensions.db

# ── Public demo (single server; replaceable guest policy) ────────────────────
# true opens the public guest demo and replaces the WhatsApp admin gate with
# per-browser ownership. false restores the existing app and WhatsApp gate.
# Origins allowed to embed the app in an iframe (comma-separated), e.g. the site
# that hosts the /embed chat bubble. The app itself is always allowed.
EMBED_ALLOWED_ORIGINS=https://ismaelfrancisco.tech,https://www.ismaelfrancisco.tech
DEMO=false
DEMO_DB=.data/demo.db
# Shared allowance across web chat + linked WhatsApp; 1 conversation per guest.
# Estimated tokens, including repeated context, images and tool allowances.
DEMO_TOKEN_LIMIT=16000
DEMO_TURN_LIMIT=4
# Lifetime caps for this demo database, not daily limits.
DEMO_GLOBAL_TOKEN_LIMIT=500000
DEMO_USER_LIMIT=200
DEMO_CONTACT_URL=mailto:ismaelfcom93@gmail.com
# Existing WhatsApp owner gate, used only when DEMO=false.
WHATSAPP_ADMIN_KEY=

# Per-IP fixed windows; persists across cookie clearing and server restarts.
DEMO_IP_GUEST_LIMIT=3
# Message submissions only; reloads and conversation setup are exempt.
DEMO_IP_CHAT_LIMIT=10
DEMO_IP_WHATSAPP_LIMIT=5
# API mutations, excluding conversation creation/resume; reads/SSE are exempt.
DEMO_IP_API_LIMIT=120
# Only trust actual reverse-proxy IPs/CIDRs. Empty = direct TCP peer.
# For Caddy on this same host: loopback; Caddy in Docker Compose (Oracle): uniquelocal.
# Never use a universal subnet.
DEMO_TRUSTED_PROXIES=

# ── Slack (Socket Mode; app/.server/slack.ts) ────────────────────────────────
# With both set, the agent answers @mentions in channels it was invited to and DMs, in the
# message's thread. Slack app: Socket Mode on (app token with `connections:write`); bot scopes
# app_mentions:read, chat:write, channels:history, groups:history, im:history, reactions:write,
# users:read, files:read, files:write; bot events app_mention and message.im; App Home →
# Messages tab on. With DEMO=true it speaks as its own full-access guest (label `slack`).
# SLACK_LOG=debug to see the socket.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Who may use the agent from Slack; with neither set, Slack stays off. The agent runs tools in
# its box without asking, so keep this tight. Recommended: one private channel (#agent) in
# SLACK_ALLOWED_CHANNELS; access is then channel membership, managed in Slack, no restart.
# SLACK_ALLOWED_USERS (profile → ⋮ → Copy member ID) is for the few who may also DM the bot.
# Channel id: channel name → About, at the bottom. Users from other organizations (Slack
# Connect) are always ignored.
SLACK_ALLOWED_USERS=
SLACK_ALLOWED_CHANNELS=

# ── Images (mcp/image.ts; installed by scripts/install-image-mcp.mjs) ─────────
# Secret `sk_` key from https://enter.pollinations.ai/keys. The installer writes it to the box
# (/etc/image-mcp.env, root only); the app never uses it. Empty = anonymous generator, which
# answers 429 after a few images.
POLLINATIONS_KEY=

# ── Google Maps ──────────────────────────────────────────────────────────────
# GM_DEMO_KEY reaches the browser (window.ENV) to draw maps on /gmaps.
GM_DEMO_KEY=
# Server-only key for MCP Grounding Lite (scripts/install-maps-mcp.mjs). Empty = uses
# GM_DEMO_KEY. Keep them separate in production: the browser key is referrer-restricted
# and that restriction does not work for agent calls.
GM_MCP_KEY=

# ── Attachments (docs/agent-storage.md#user-uploads) ─────────────────────────
# Bucket for documents users upload, with an app-only key (not the box's).
# Empty = documents cannot be attached (images still can).
UPLOAD_ENDPOINT=
UPLOAD_BUCKET=
UPLOAD_REGION=
UPLOAD_ACCESS_KEY_ID=
UPLOAD_SECRET_ACCESS_KEY=
# Folder inside the bucket (default uploads/; locally, uploads-dev/).
UPLOAD_PREFIX=

# Public URL for link previews (og:image). Optional: falls back to https://$APP_DOMAIN,
# then to the request origin.
# PUBLIC_URL=https://robbie.example.com

# ── Lathe simulator agent (/lathe, docs/lathe/plan.md) ──────────────────────────
# A separate agent box that writes lathe jobs. Same meaning as the ACP_* values above, but for
# that box; the chat never reads these. Without CNC_ACP_WS_URL, /lathe still loads and pastes jobs.
CNC_ACP_WS_URL=
CNC_ACP_SECRET=
# 1 = also send the secret as ?token= (only if a proxy drops the Authorization header)
CNC_ACP_TOKEN_IN_URL=
CNC_AGENT_BOX_ID=
# Optional: close the idle connection after this many ms so the box can sleep (default 300000).
CNC_ACP_IDLE_MS=
# Optional: defaults to /data/work and 60000.
CNC_ACP_CWD=
CNC_ACP_SESSION_TIMEOUT_MS=
# Optional: cancel a turn that runs longer than this many ms (default 240000). The agent thinks
# silently before it answers, and that thinking is billed even if nobody gets the answer.
CNC_ACP_TURN_TIMEOUT_MS=
# Optional: thinking effort for each lathe session (low, medium, high, xhigh, max; default medium).
# The box's own default thinks for minutes per job.
CNC_ACP_THINKING_EFFORT=
