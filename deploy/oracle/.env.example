# A domain whose A record points at this VM's public IPv4 address.
APP_DOMAIN=agent.example.com

# Remote ACP agent. These remain in the app container only.
ACP_WS_URL=wss://acp-<agent-id>.example.com/acp
ACP_TOKEN=
ACP_CWD=/data/work

# Protect the WhatsApp pairing screen in production with a long random value.
WHATSAPP_ADMIN_KEY=

# Keep the existing app-side SQLite data on the VM's persistent disk.
ACP_EXTENSIONS_DB=.data/extensions.db
ACP_TITLES_DB=.data/titles.db
DEMO_DB=.data/demo.db

# Public demo. Every value below has a built-in default (shown); see
# docs/public-demo.md. Limits are read on each request: edit, then
# `docker compose up -d --force-recreate app`.
DEMO=false
DEMO_CONTACT_URL=mailto:ismaelfcom93@gmail.com
# Origins allowed to embed the app in an iframe (comma-separated).
EMBED_ALLOWED_ORIGINS=
# Per guest: one conversation, shared by web chat and linked WhatsApp.
DEMO_TOKEN_LIMIT=16000
DEMO_TURN_LIMIT=4
# Lifetime caps for this demo database, not daily limits.
DEMO_GLOBAL_TOKEN_LIMIT=500000
DEMO_USER_LIMIT=200
# Per-IP fixed windows: new guests / 24 h, chat messages / min,
# WhatsApp pair attempts / h, API mutations / min.
DEMO_IP_GUEST_LIMIT=3
DEMO_IP_CHAT_LIMIT=10
DEMO_IP_WHATSAPP_LIMIT=5
DEMO_IP_API_LIMIT=120
# Caddy reaches the app over the Compose network (a private address). Trust it for
# X-Forwarded-For, or every visitor shares Caddy's IP in the per-IP limits. Safe
# only because port 3000 is not published.
DEMO_TRUSTED_PROXIES=uniquelocal

# Optional: only if this app should manage the agent sandbox lifecycle.
AGENT_BOX_ID=
EASYBITS_API_KEY=
AGENT_SNAPSHOT_ID=

# Optional Turso credentials. The current SQLite stores do not use these until their
# persistence layer is migrated; do not remove the persistent .data volume yet.
TURSO_DATABASE_URL=libsql://acp-agent-db-frankismael.aws-us-east-2.turso.io
TURSO_SQLITE=
