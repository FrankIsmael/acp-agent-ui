# A domain whose A record points at this VM's public IPv4 address.
APP_DOMAIN=agent.example.com

# Remote ACP agent. These remain in the app container only.
ACP_WS_URL=wss://acp-<agent-id>.example.com/acp
ACP_TOKEN=
ACP_CWD=/data/work

# Protect the WhatsApp pairing screen in production with a long random value.
WHATSAPP_ADMIN_KEY=

# Keep the existing app-side SQLite data on the VM's persistent disk.
ACP_EXTENSIONS_DB=.data/extensions.db
ACP_TITLES_DB=.data/titles.db
DEMO_DB=.data/demo.db

# Optional: only if this app should manage the agent sandbox lifecycle.
AGENT_BOX_ID=
EASYBITS_API_KEY=
AGENT_SNAPSHOT_ID=

# Optional Turso credentials. The current SQLite stores do not use these until their
# persistence layer is migrated; do not remove the persistent .data volume yet.
TURSO_DATABASE_URL=libsql://acp-agent-db-frankismael.aws-us-east-2.turso.io
TURSO_SQLITE=
