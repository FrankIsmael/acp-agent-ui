[Unit]
Description=Deploy the newest acp-agent-ui image from GHCR
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=opc
# Through bash: SELinux will not let systemd exec a script under /home directly.
ExecStart=/bin/bash /home/opc/acp-agent-ui/deploy/oracle/deploy.sh
TimeoutStartSec=15min
