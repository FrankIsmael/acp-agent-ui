import { readFileSync } from 'node:fs';
import { client } from '@agentclientprotocol/sdk';
import { createWebSocketStream } from '@agentclientprotocol/sdk/experimental/ws-client';
import { WebSocket } from 'ws';
import { jobFromReply } from './app/lathe/agent-reply.ts';
import { checkJob } from './app/lathe/sim/check.ts';
import { setupBrief } from './app/lathe/setup-brief.ts';
import ex from './app/lathe/examples/pulley.json' with { type: 'json' };
const effort = process.argv[2] ?? 'low';
const skill = readFileSync('.agents/skills/lathe-job/SKILL.md', 'utf8').replace(/^---\n[\s\S]*?\n---\n/, '').trim();
const clean = (v?: string) => (v ?? '').trim().replace(/^(["'])(.*)\1$/, '$2');
const app = client({ name: 'probe' } as any);
let reply = ''; let tools = 0;
app.onNotification('session/update', ({ params }: any) => { const u = params.update; if (u.sessionUpdate === 'tool_call') tools++; if (u.sessionUpdate === 'agent_message_chunk' && u.content?.type === 'text') reply += u.content.text; });
app.onRequest('session/request_permission', () => ({ outcome: { outcome: 'cancelled' } }));
const conn = app.connect(createWebSocketStream(clean(process.env.CNC_ACP_WS_URL), { WebSocket, headers: { Authorization: `Bearer ${clean(process.env.CNC_ACP_SECRET)}` } } as any));
await conn.agent.request('initialize', { protocolVersion: 1, clientCapabilities: {} });
const s: any = await conn.agent.request('session/new', { cwd: '/data/work', mcpServers: [] });
await conn.agent.request('session/set_config_option', { sessionId: s.sessionId, configId: 'thinking_effort', value: effort });
const setup = { material: (ex as any).material, stock: (ex as any).stock, tools: (ex as any).tools };
const text = `${skill}\n\n---\n\n${setupBrief(setup as any)}\n\n---\n\nNow create a cone piece, propose any other feature and values`;
const t0 = Date.now();
await conn.agent.request('session/prompt', { sessionId: s.sessionId, prompt: [{ type: 'text', text }] });
console.log(effort, 'seconds', (Date.now() - t0) / 1000, 'toolCalls', tools);
const res = jobFromReply(reply);
console.log(JSON.stringify(res.ok ? { problems: checkJob(res.job) } : { formatErrors: res.errors }));
conn.close(); process.exit(0);
